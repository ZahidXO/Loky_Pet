{
  "buildCommand": "dotnet publish src/LokyPet.Web/LokyPet.Client.csproj -c Release -o publish",
  "outputDirectory": "publish/wwwroot",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!_framework|_content|css|js|images|favicon|icon-|appsettings).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/_framework/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "application/javascript" }
      ]
    },
    {
      "source": "/_framework/(.*).wasm",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "application/wasm" }
      ]
    }
  ]
}
