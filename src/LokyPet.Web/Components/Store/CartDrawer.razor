@* CartDrawer: panel lateral deslizable desde la derecha.
   Muestra los items del carrito, subtotal y acciones rápidas. *@
@inject LokyPet.Application.Interfaces.ICartService Cart
@inject NavigationManager Nav

<div class="fixed inset-0 z-50 @(_visible ? "" : "pointer-events-none")">
    @* Overlay *@
    <div class="absolute inset-0 bg-black/30 transition-opacity duration-300 @(_visible ? "opacity-100" : "opacity-0")"
         @onclick="Close"></div>

    @* Drawer panel *@
    <aside class="absolute top-0 end-0 h-full w-full max-w-md bg-base-100 shadow-soft-lg transition-transform duration-300 ease-loky @(_visible ? "translate-x-0" : "translate-x-full") flex flex-col">
        @* Header *@
        <div class="flex items-center justify-between p-4 border-b border-base-300">
            <h2 class="font-semibold text-lg text-primary">Tu carrito</h2>
            <button class="btn btn-ghost btn-circle btn-sm" @onclick="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        @* Items *@
        <div class="flex-1 overflow-y-auto p-4 space-y-4">
            @if (_items.Any())
            {
                @foreach (var item in _items)
                {
                    <div class="flex gap-3">
                        <img src="@item.Image" alt="@item.ProductName"
                             class="w-16 h-16 rounded-xl bg-secondary/40 object-contain p-1" />
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-base-content truncate">@item.ProductName</p>
                            <p class="text-xs text-base-content/60">@item.ColorName</p>
                            <div class="flex items-center justify-between mt-1">
                                <span class="text-sm font-semibold text-primary">@FormatPrice(item.UnitPrice)</span>
                                <div class="flex items-center gap-2">
                                    <span class="text-xs text-base-content/60">×@item.Quantity</span>
                                    <button class="btn btn-ghost btn-xs text-error"
                                            @onclick="() => RemoveItem(item.VariantSlug)">
                                        <i class="fa-solid fa-trash-can text-xs"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-8">
                    <i class="fa-solid fa-paw text-3xl text-base-content/20 mb-3"></i>
                    <p class="text-sm text-base-content/50">Tu carrito está vacío</p>
                </div>
            }
        </div>

        @* Footer *@
        @if (_items.Any())
        {
            <div class="p-4 border-t border-base-300 space-y-3">
                <div class="flex justify-between font-semibold text-primary">
                    <span>Subtotal</span>
                    <span>@FormatPrice(_items.Sum(i => i.LineTotal))</span>
                </div>
                <a href="carrito"
                   class="btn bg-primary text-primary-content border-0 rounded-full w-full"
                   @onclick="Close">
                    Ver carrito
                </a>
                <button class="btn btn-ghost text-primary rounded-full w-full" @onclick="Close">
                    Seguir comprando
                </button>
            </div>
        }
    </aside>
</div>

@code {
    private bool _visible;
    private List<LokyPet.Application.DTOs.CartItemDto> _items = new();

    private static readonly System.Globalization.CultureInfo Mx = LokyPet.Domain.ValueObjects.Money.MxDot;
    private static string FormatPrice(decimal v) => v.ToString("C2", Mx);

    public async Task OpenAsync()
    {
        _items = await Cart.GetItemsAsync();
        _visible = true;
        StateHasChanged();
    }

    private void Close()
    {
        _visible = false;
        StateHasChanged();
    }

    private async Task RemoveItem(string slug)
    {
        await Cart.RemoveItemAsync(slug);
        _items = await Cart.GetItemsAsync();
        StateHasChanged();
    }
}
