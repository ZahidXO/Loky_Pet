@page "/dashboard/mensajes"
@layout LokyPet.Client.Layout.DashboardLayout
@inject LokyPet.Client.Services.DashboardService Dash

<PageTitle>Mensajes — Dashboard LOKY PET</PageTitle>

<div class="space-y-6 page-enter">
    <h2 class="text-2xl font-semibold text-primary">Mensajes de contacto</h2>

    @if (_loading)
    {
        <div class="space-y-3">
            @for (int i = 0; i < 5; i++)
            {
                <div class="h-24 rounded-2xl skeleton-shimmer"></div>
            }
        </div>
    }
    else if (_messages.Count == 0)
    {
        <div class="rounded-2xl bg-base-100 shadow-soft p-10 text-center">
            <div class="w-16 h-16 rounded-full bg-secondary grid place-items-center mx-auto mb-4">
                <i class="fa-solid fa-envelope text-primary text-2xl"></i>
            </div>
            <p class="text-base-content/60">No hay mensajes a&uacute;n.</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var msg in _messages)
            {
                <div class="rounded-2xl bg-base-100 shadow-soft p-5 space-y-3 @(msg.Status == "nuevo" ? "border-l-4 border-accent" : "")">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1">
                                <h3 class="font-semibold text-primary text-sm">@msg.Name</h3>
                                <span class="badge @StatusBadge(msg.Status) badge-xs">@StatusLabel(msg.Status)</span>
                            </div>
                            <p class="text-xs text-base-content/50">
                                @msg.Email
                                @if (!string.IsNullOrEmpty(msg.Phone))
                                {
                                    <span> &middot; @msg.Phone</span>
                                }
                                &middot; @msg.CreatedAt.ToString("dd MMM yyyy HH:mm", Mx)
                            </p>
                        </div>
                        <span class="badge badge-outline badge-sm flex-shrink-0">@msg.Subject</span>
                    </div>

                    <p class="text-sm text-base-content/80 leading-relaxed whitespace-pre-wrap">@msg.Message</p>

                    <div class="flex items-center gap-2">
                        @if (msg.Status == "nuevo")
                        {
                            <button class="btn btn-xs btn-ghost gap-1"
                                    @onclick="() => MarkAsRead(msg)">
                                <i class="fa-solid fa-eye text-xs"></i> Marcar le&iacute;do
                            </button>
                        }
                        @if (msg.Status != "respondido")
                        {
                            <button class="btn btn-xs btn-ghost gap-1 text-success"
                                    @onclick="() => MarkAsReplied(msg)">
                                <i class="fa-solid fa-check text-xs"></i> Marcar respondido
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<DashboardService.MessageRow> _messages = new();
    private static readonly System.Globalization.CultureInfo Mx = LokyPet.Domain.ValueObjects.Money.MxDot;

    protected override async Task OnInitializedAsync()
    {
        try { _messages = await Dash.GetAllMessagesAsync(); }
        catch { }
        finally { _loading = false; }
    }

    private Task MarkAsRead(DashboardService.MessageRow msg) => MarkAs(msg, "leido");
    private Task MarkAsReplied(DashboardService.MessageRow msg) => MarkAs(msg, "respondido");

    private async Task MarkAs(DashboardService.MessageRow msg, string status)
    {
        msg.Status = status;
        await Dash.UpdateMessageStatusAsync(msg.Id, status);
        StateHasChanged();
    }

    private static string StatusBadge(string s) => s switch
    {
        "nuevo" => "badge-accent",
        "leido" => "badge-info",
        "respondido" => "badge-success",
        _ => "badge-ghost"
    };

    private static string StatusLabel(string s) => s switch
    {
        "nuevo" => "Nuevo",
        "leido" => "Le\u00eddo",
        "respondido" => "Respondido",
        _ => s
    };
}
