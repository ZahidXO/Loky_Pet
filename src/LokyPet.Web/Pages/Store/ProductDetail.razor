@page "/accesorios/{Slug}"
@using System.Globalization
@using LokyPet.Application.DTOs
@using LokyPet.Application.Interfaces
@using LokyPet.Domain.Policies
@using LokyPet.Client.Services
@inject LokyPet.Client.Services.CatalogService Catalog
@inject LokyPet.Application.Interfaces.ICartService Cart
@inject LokyPet.Domain.Policies.ShippingPolicy Shipping
@inject NavigationManager Nav

<PageTitle>@(_variant?.ProductName ?? "Producto") — LOKY PET</PageTitle>

<div class="page-enter">

@if (_loading)
{
    @* ===== SKELETON LOADING STATE ===== *@
    <section class="mx-auto max-w-[1440px] px-6 pt-6 pb-4">
        <div class="h-4 w-64 rounded-full skeleton-shimmer"></div>
    </section>

    <section class="mx-auto max-w-[1440px] px-6 pb-16">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
            @* Image skeleton *@
            <div class="aspect-square rounded-2xl skeleton-shimmer"></div>
            @* Info skeleton *@
            <div class="space-y-4 py-2">
                <div class="h-8 w-3/4 rounded-full skeleton-shimmer"></div>
                <div class="h-4 w-1/4 rounded-full skeleton-shimmer"></div>
                <div class="h-10 w-1/3 rounded-full skeleton-shimmer"></div>
                <div class="h-4 w-full rounded-full skeleton-shimmer"></div>
                <div class="h-4 w-full rounded-full skeleton-shimmer"></div>
                <div class="h-4 w-2/3 rounded-full skeleton-shimmer"></div>
                <div class="h-12 w-full rounded-full skeleton-shimmer mt-6"></div>
            </div>
        </div>
    </section>
}
else if (_variant is null)
{
    @* ===== NOT FOUND STATE ===== *@
    <section class="mx-auto max-w-[1440px] px-6 py-20 text-center">
        <div class="mx-auto w-20 h-20 rounded-full bg-secondary grid place-items-center mb-5">
            <i class="fa-solid fa-paw text-primary text-3xl"></i>
        </div>
        <h1 class="text-2xl font-semibold text-primary mb-2">Producto no encontrado</h1>
        <p class="text-base-content/60 mb-6 max-w-sm mx-auto">
            No pudimos encontrar el producto que buscas. Es posible que haya sido retirado o que la dirección sea incorrecta.
        </p>
        <a href="/accesorios" class="btn bg-primary text-primary-content border-0 rounded-full px-6">
            <i class="fa-solid fa-arrow-left me-2"></i> Volver a Accesorios
        </a>
    </section>
}
else
{
    @* ===== 1. BREADCRUMB ===== *@
    <nav class="mx-auto max-w-[1440px] px-6 pt-6 pb-4" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1 text-sm text-base-content/60">
            <li><a href="/" class="hover:text-primary transition-colors">Inicio</a></li>
            <li class="before:content-['›'] before:mx-1">
                <a href="/accesorios" class="hover:text-primary transition-colors">Accesorios</a>
            </li>
            <li class="before:content-['›'] before:mx-1">
                <a href="/accesorios?cat=@Uri.EscapeDataString(_variant.CategorySlug)" class="hover:text-primary transition-colors">@_variant.CategoryName</a>
            </li>
            <li class="before:content-['›'] before:mx-1 text-base-content font-medium">
                @_variant.ProductName – @_variant.ColorName
            </li>
        </ol>
    </nav>

    @* ===== 2 & 3. MAIN LAYOUT: IMAGE + INFO ===== *@
    <section class="mx-auto max-w-[1440px] px-6 pb-12">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">

            @* ===== LEFT: IMAGE GALLERY ===== *@
            <div class="lg:sticky lg:top-24">
                <div class="aspect-square rounded-2xl bg-secondary/40 p-6 overflow-hidden cursor-zoom-in">
                    <img src="@_variant.Image"
                         alt="@_variant.ProductName – @_variant.ColorName"
                         class="w-full h-full object-contain transition-transform duration-300 ease-loky hover:scale-105" />
                </div>
                @* Thumbnail placeholder for future multi-image support *@
            </div>

            @* ===== RIGHT: PRODUCT INFO ===== *@
            <div class="lg:sticky lg:top-24 space-y-6">

                @* Product Name & SKU *@
                <div>
                    <h1 class="text-2xl font-semibold text-base-content">@_variant.ProductName – @_variant.ColorName</h1>
                    <p class="text-xs text-base-content/50 mt-1">SKU: @_variant.Sku</p>
                </div>

                @* ===== PRICE BLOCK ===== *@
                <div>
                    <span class="text-3xl font-semibold text-primary">@FormatPrice(_variant.PriceMxn)</span>
                    <p class="text-xs text-base-content/50 mt-1">IVA incluido</p>
                </div>

                @* ===== COLOR SELECTOR ===== *@
                @if (_siblings.Count > 1)
                {
                    <div>
                        <p class="text-sm font-medium text-base-content mb-2">
                            Color: <span class="font-normal text-base-content/70">@_variant.ColorName</span>
                        </p>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var sibling in _siblings)
                            {
                                var siblingSlug = sibling.Slug;
                                var isActive = sibling.Slug == _variant.Slug;
                                <button @onclick="() => NavigateToVariant(siblingSlug)" class="focus:outline-none" aria-label="@sibling.ColorName">
                                    <ColorSwatch Hex="sibling.ColorHex" Title="@sibling.ColorName" Active="isActive" />
                                </button>
                            }
                        </div>
                    </div>
                }

                @* ===== DESCRIPTION ===== *@
                @if (!string.IsNullOrWhiteSpace(_variant.Description))
                {
                    <div>
                        <h2 class="text-sm font-semibold text-base-content mb-1">Descripción</h2>
                        <p class="text-sm text-base-content/70 leading-relaxed">@_variant.Description</p>
                    </div>
                }

                @* ===== DETAILS BLOCK ===== *@
                <div class="space-y-2 text-sm">
                    <h2 class="font-semibold text-base-content">Detalles</h2>
                    <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-base-content/70">
                        <dt class="font-medium text-base-content">Categoría</dt>
                        <dd>@_variant.CategoryName</dd>
                        <dt class="font-medium text-base-content">Color</dt>
                        <dd>@_variant.ColorName</dd>
                        <dt class="font-medium text-base-content">Origen</dt>
                        <dd>Hecho con textiles reciclados en Reynosa, Tamaulipas</dd>
                    </dl>
                </div>

                @* ===== QUANTITY SELECTOR ===== *@
                <div>
                    <p class="text-sm font-medium text-base-content mb-2">Cantidad</p>
                    <div class="flex items-center gap-3">
                        <button class="btn btn-sm btn-circle bg-base-200 border-0 text-base-content hover:bg-base-300 disabled:opacity-40"
                                disabled="@(_qty <= 1)"
                                @onclick="DecrementQty">
                            <i class="fa-solid fa-minus text-xs"></i>
                        </button>
                        <span class="text-lg font-semibold w-8 text-center">@_qty</span>
                        <button class="btn btn-sm btn-circle bg-base-200 border-0 text-base-content hover:bg-base-300 disabled:opacity-40"
                                disabled="@(_qty >= _variant.Stock)"
                                @onclick="IncrementQty">
                            <i class="fa-solid fa-plus text-xs"></i>
                        </button>
                        @if (_variant.Stock <= 5 && !_variant.IsOutOfStock)
                        {
                            <span class="text-xs text-warning font-medium">
                                @(_variant.Stock == 1 ? "Última pieza" : $"Quedan {_variant.Stock}")
                            </span>
                        }
                    </div>
                </div>

                @* ===== ADD TO CART BUTTON (desktop) ===== *@
                <div class="hidden lg:block">
                    <button class="btn w-full bg-primary text-primary-content border-0 rounded-full text-base font-semibold shadow-soft hover:shadow-soft-lg transition-all duration-200 disabled:opacity-40"
                            disabled="@_variant.IsOutOfStock"
                            @onclick="AddToCart">
                        <i class="fa-solid fa-cart-shopping me-2"></i>
                        @(_variant.IsOutOfStock ? "Agotado" : "Agregar al carrito")
                    </button>
                </div>

                @* ===== 4. SHIPPING INFO BLOCK ===== *@
                <div class="space-y-3">
                    <div class="flex items-start gap-3 rounded-xl bg-base-200/60 p-4">
                        <i class="fa-solid fa-truck-fast text-primary text-lg mt-0.5"></i>
                        <div>
                            <p class="text-sm font-semibold text-base-content">Envío gratis en @Shipping.LocalCity</p>
                            <p class="text-xs text-base-content/60">@Shipping.LocalDeliveryTime</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 rounded-xl bg-base-200/60 p-4">
                        <i class="fa-solid fa-box text-primary text-lg mt-0.5"></i>
                        <div>
                            <p class="text-sm font-semibold text-base-content">Resto de México: @Shipping.NationalShippingCost.Format() MXN por @Shipping.NationalCarrier</p>
                            <p class="text-xs text-base-content/60">@Shipping.NationalDeliveryTime</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 rounded-xl bg-base-200/60 p-4">
                        <i class="fa-solid fa-rotate-left text-primary text-lg mt-0.5"></i>
                        <div>
                            <p class="text-sm font-semibold text-base-content">Devolución hasta 10 días naturales</p>
                            <p class="text-xs text-base-content/60">
                                Por defectos de confección o empaque.
                                <a href="/sobre-nosotros?tab=envios" class="text-primary hover:underline">Más información</a>
                            </p>
                        </div>
                    </div>
                </div>

            </div> @* end product info *@
        </div>
    </section>

    @* ===== 5. SIMILAR PRODUCTS CAROUSEL ===== *@
    @if (_similar.Count > 0)
    {
        <section class="mx-auto max-w-[1440px] px-6 pb-16">
            <h2 class="text-xl font-semibold text-base-content mb-6">También te puede interesar</h2>
            <div class="flex gap-4 sm:gap-6 overflow-x-auto pb-4 scrollbar-thin snap-x snap-mandatory">
                @foreach (var item in _similar)
                {
                    <div class="min-w-[220px] max-w-[260px] flex-shrink-0 snap-start">
                        <ProductCard Product="ToDemo(item)" OnAddToCart="HandleAddToCartSimilar" />
                    </div>
                }
            </div>
        </section>
    }

    @* ===== MOBILE FIXED ADD-TO-CART BAR ===== *@
    <div class="fixed bottom-0 inset-x-0 z-40 bg-base-100 border-t border-base-300 p-4 lg:hidden shadow-[0_-4px_12px_rgba(0,0,0,0.08)]">
        <div class="flex items-center gap-3 max-w-lg mx-auto">
            <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-primary truncate">@FormatPrice(_variant.PriceMxn)</p>
            </div>
            <button class="btn flex-1 bg-primary text-primary-content border-0 rounded-full font-semibold shadow-soft disabled:opacity-40"
                    disabled="@_variant.IsOutOfStock"
                    @onclick="AddToCart">
                <i class="fa-solid fa-cart-shopping me-2"></i>
                @(_variant.IsOutOfStock ? "Agotado" : "Agregar al carrito")
            </button>
        </div>
    </div>

    @* Extra bottom padding on mobile to avoid overlap with fixed bar *@
    <div class="h-24 lg:hidden"></div>
}

</div>

@* ===== Scrollbar styles ===== *@
<style>
    .scrollbar-thin::-webkit-scrollbar { height: 6px; }
    .scrollbar-thin::-webkit-scrollbar-track { background: oklch(var(--b2)); border-radius: 3px; }
    .scrollbar-thin::-webkit-scrollbar-thumb { background: oklch(var(--p) / 0.3); border-radius: 3px; }
    .scrollbar-thin::-webkit-scrollbar-thumb:hover { background: oklch(var(--p) / 0.5); }
</style>

@code {
    // ===== Parameter =====
    [Parameter] public string Slug { get; set; } = "";

    // ===== State =====
    private ProductVariantDto? _variant;
    private List<ProductVariantDto> _siblings = new();
    private List<ProductVariantDto> _similar = new();
    private int _qty = 1;
    private bool _loading = true;

    // ===== Formatting =====
    private static readonly CultureInfo Mx = LokyPet.Domain.ValueObjects.Money.MxDot;
    private static string FormatPrice(decimal value) => value.ToString("C2", Mx);

    // ===== Lifecycle =====
    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _qty = 1;
        StateHasChanged();

        try
        {
            _variant = await Catalog.GetVariantBySlugAsync(Slug);

            if (_variant is not null)
            {
                // Get all variants of the same base product (color siblings)
                _siblings = await Catalog.GetVariantsByProductIdAsync(_variant.ProductId);

                // Build similar products: other siblings + same category (exclude current variant)
                var allVariants = await Catalog.GetAllVariantsAsync();

                var similarSet = new List<ProductVariantDto>();

                // Add siblings first (other colors of same product, excluding current)
                similarSet.AddRange(_siblings.Where(s => s.Id != _variant.Id));

                // Then add products from the same category (excluding same product variants)
                var sameCat = allVariants
                    .Where(v => v.CategorySlug == _variant.CategorySlug && v.ProductId != _variant.ProductId)
                    .ToList();
                similarSet.AddRange(sameCat);

                _similar = similarSet.Take(6).ToList();
            }
        }
        catch
        {
            _variant = null;
        }
        finally
        {
            _loading = false;
        }
    }

    // ===== Quantity =====
    private void IncrementQty()
    {
        if (_variant is not null && _qty < _variant.Stock)
            _qty++;
    }

    private void DecrementQty()
    {
        if (_qty > 1)
            _qty--;
    }

    // ===== Navigation =====
    private void NavigateToVariant(string slug)
    {
        Nav.NavigateTo($"/accesorios/{slug}");
    }

    // ===== Add to Cart =====
    private async Task AddToCart()
    {
        if (_variant is null || _variant.IsOutOfStock) return;

        await Cart.AddItemAsync(new CartItemDto
        {
            VariantId = _variant.Id,
            VariantSlug = _variant.Slug,
            Sku = _variant.Sku,
            ProductName = _variant.ProductName,
            ColorName = _variant.ColorName,
            ColorHex = _variant.ColorHex,
            UnitPrice = _variant.PriceMxn,
            CompareAtPrice = _variant.CompareAtPriceMxn,
            Image = _variant.Image,
            Quantity = _qty,
            MaxStock = _variant.Stock
        });
    }

    private async Task HandleAddToCartSimilar(DemoProduct demo)
    {
        var all = await Catalog.GetAllVariantsAsync();
        var variant = all.FirstOrDefault(v => v.Sku == demo.Sku);
        if (variant is null || variant.IsOutOfStock) return;

        await Cart.AddItemAsync(new CartItemDto
        {
            VariantId = variant.Id,
            VariantSlug = variant.Slug,
            Sku = variant.Sku,
            ProductName = variant.ProductName,
            ColorName = variant.ColorName,
            ColorHex = variant.ColorHex,
            UnitPrice = variant.PriceMxn,
            CompareAtPrice = variant.CompareAtPriceMxn,
            Image = variant.Image,
            Quantity = 1,
            MaxStock = variant.Stock
        });
    }

    // ===== Mapping =====
    private static DemoProduct ToDemo(ProductVariantDto v) => new()
    {
        Sku = v.Sku,
        Name = $"{v.ProductName} – {v.ColorName}",
        Slug = v.Slug,
        Category = v.CategoryName,
        ColorName = v.ColorName,
        ColorHex = v.ColorHex,
        PriceMxn = v.PriceMxn,
        CompareAtPriceMxn = v.CompareAtPriceMxn,
        Stock = v.IsOutOfStock ? 0 : v.Stock,
        Image = v.Image,
    };
}
