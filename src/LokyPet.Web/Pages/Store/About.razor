@code {
    // ===== Tab state =====
    private int _activeTab;

    // ===== Tab definitions =====
    private readonly TabDef[] _tabs =
    {
        new("fa-file-lines", "T\u00e9rminos y Condiciones"),
        new("fa-user-shield", "Aviso de Privacidad"),
        new("fa-truck", "Env\u00edos y Devoluciones"),
        new("fa-leaf", "Garant\u00eda de Sustentabilidad"),
    };

    // ===== Valores data =====
    private readonly ValorDef[] _valores =
    {
        new("fa-leaf", "Sustentabilidad", "Cada producto le da una segunda vida a un textil."),
        new("fa-paw", "Bienestar animal", "Dise\u00f1amos pensando en la comodidad y seguridad de cada mascota."),
        new("fa-scale-balanced", "Transparencia", "Operamos con reglas claras y cumplimiento legal."),
        new("fa-lightbulb", "Creatividad", "Convertimos retazos en piezas \u00fanicas y divertidas."),
        new("fa-gem", "Calidad artesanal", "Confecci\u00f3n cuidadosa, pieza por pieza."),
        new("fa-map-pin", "Compromiso local", "Orgullosamente hechos en Reynosa, Tamaulipas."),
    };

    // ===== Tab query-param mapping =====
    private static readonly Dictionary<string, int> TabMap = new(StringComparer.OrdinalIgnoreCase)
    {
        ["terminos"]         = 0,
        ["privacidad"]       = 1,
        ["envios"]           = 2,
        ["sustentabilidad"]  = 3,
    };

    // ===== Lifecycle =====
    protected override void OnInitialized()
    {
        ParseTabQueryParam();
    }

    /// <summary>Parse ?tab= from the URL and set _activeTab.</summary>
    private void ParseTabQueryParam()
    {
        var uri = new Uri(Nav.Uri);
        var query = uri.Query;
        if (string.IsNullOrEmpty(query)) return;

        var pairs = query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
        foreach (var pair in pairs)
        {
            var parts = pair.Split('=', 2);
            if (parts.Length != 2) continue;

            var key = Uri.UnescapeDataString(parts[0]).ToLowerInvariant();
            if (key == "tab")
            {
                var value = Uri.UnescapeDataString(parts[1]);
                if (TabMap.TryGetValue(value, out var idx))
                {
                    _activeTab = idx;
                }
                break;
            }
        }
    }

    // ===== Tab switching =====
    private void SetActiveTab(int idx)
    {
        _activeTab = idx;
    }

    private string TabClass(int idx) =>
        idx == _activeTab
            ? "btn btn-sm rounded-full bg-primary text-primary-content border-0 font-medium"
            : "btn btn-sm rounded-full bg-secondary text-secondary-content border-0 font-medium hover:bg-neutral hover:text-neutral-content transition-colors";

    // ===== Records =====
    private sealed record TabDef(string Icon, string Label);
    private sealed record ValorDef(string Icon, string Title, string Description);
}
