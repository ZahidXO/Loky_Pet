@page "/checkout"
@implements IDisposable
@inject LokyPet.Application.Interfaces.ICartService Cart
@inject LokyPet.Client.Services.CatalogService Catalog
@inject LokyPet.Domain.Policies.ShippingPolicy Shipping
@inject NavigationManager Nav
@inject LokyPet.Application.Interfaces.IAuthService Auth
@inject LokyPet.Application.Interfaces.IOrderRepository Orders

<PageTitle>Checkout — LOKY PET</PageTitle>

<section class="mx-auto max-w-[1440px] px-4 sm:px-6 py-10 page-enter">

    @if (_loading)
    {
        <div class="flex justify-center py-20">
            <span class="loading loading-spinner loading-lg text-primary"></span>
        </div>
    }
    else
    {
        @* ── Step Indicator ── *@
        <div class="flex items-center justify-center mb-10 gap-0">
            @for (int i = 1; i <= 3; i++)
            {
                var step = i;
                var label = step switch { 1 => "Envío", 2 => "Pago", _ => "Confirmación" };
                var icon = step switch { 1 => "fa-truck", 2 => "fa-credit-card", _ => "fa-check-circle" };
                var isCompleted = step < _currentStep;
                var isCurrent = step == _currentStep;

                @if (step > 1)
                {
                    <div class="w-12 sm:w-20 h-0.5 mx-1 transition-colors duration-300 @(isCompleted ? "bg-primary" : "bg-base-300")"></div>
                }

                <div class="flex flex-col items-center gap-1.5">
                    <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-semibold transition-all duration-300
                        @(isCompleted ? "bg-primary text-primary-content" : isCurrent ? "bg-primary text-primary-content ring-4 ring-primary/20" : "bg-base-300 text-base-content/40")">
                        @if (isCompleted)
                        {
                            <i class="fa-solid fa-check"></i>
                        }
                        else
                        {
                            <span>@step</span>
                        }
                    </div>
                    <span class="text-xs font-medium @(isCurrent || isCompleted ? "text-primary" : "text-base-content/40") hidden sm:block">@label</span>
                </div>
            }
        </div>

        <div class="grid lg:grid-cols-3 gap-8">
            @* ── Main content ── *@
            <div class="lg:col-span-2">

                @* ═══════════════ STEP 1: SHIPPING ═══════════════ *@
                @if (_currentStep == 1)
                {
                    <div class="page-enter">
                        <h2 class="text-xl font-semibold text-primary mb-6">
                            <i class="fa-solid fa-truck mr-2"></i>Información de envío
                        </h2>

                        <div class="bg-base-100 rounded-2xl shadow-soft p-6 space-y-4">
                            @* Nombre *@
                            <div>
                                <label class="label"><span class="label-text font-medium">Nombre completo *</span></label>
                                <input type="text" placeholder="Ej: María García López"
                                       class="input input-bordered w-full rounded-xl @(ShowError(nameof(_model.Name)))"
                                       @bind="_model.Name" @bind:event="oninput" />
                            </div>

                            <div class="grid sm:grid-cols-2 gap-4">
                                @* Teléfono *@
                                <div>
                                    <label class="label"><span class="label-text font-medium">Teléfono *</span></label>
                                    <input type="tel" placeholder="Ej: 899 123 4567"
                                           class="input input-bordered w-full rounded-xl @(ShowError(nameof(_model.Phone)))"
                                           @bind="_model.Phone" @bind:event="oninput" />
                                </div>
                                @* Correo *@
                                <div>
                                    <label class="label"><span class="label-text font-medium">Correo electrónico *</span></label>
                                    <input type="email" placeholder="correo@ejemplo.com"
                                           class="input input-bordered w-full rounded-xl @(ShowError(nameof(_model.Email)))"
                                           @bind="_model.Email" @bind:event="oninput" />
                                </div>
                            </div>

                            @* Dirección *@
                            <div>
                                <label class="label"><span class="label-text font-medium">Dirección *</span></label>
                                <input type="text" placeholder="Calle, número, colonia"
                                       class="input input-bordered w-full rounded-xl @(ShowError(nameof(_model.Address)))"
                                       @bind="_model.Address" @bind:event="oninput" />
                            </div>

                            <div class="grid sm:grid-cols-3 gap-4">
                                @* Código postal *@
                                <div>
                                    <label class="label"><span class="label-text font-medium">Código postal *</span></label>
                                    <input type="text" placeholder="88500"
                                           class="input input-bordered w-full rounded-xl @(ShowError(nameof(_model.ZipCode)))"
                                           @bind="_model.ZipCode" @bind:event="oninput" />
                                </div>
                                @* Ciudad *@
                                <div>
                                    <label class="label"><span class="label-text font-medium">Ciudad *</span></label>
                                    <input type="text" placeholder="Reynosa"
                                           class="input input-bordered w-full rounded-xl @(ShowError(nameof(_model.City)))"
                                           @bind="_model.City" @bind:event="oninput"
                                           @onfocusout="OnAddressChanged" />
                                </div>
                                @* Estado *@
                                <div>
                                    <label class="label"><span class="label-text font-medium">Estado *</span></label>
                                    <select class="select select-bordered w-full rounded-xl @(ShowError(nameof(_model.State)))"
                                            @bind="_model.State" @bind:after="OnAddressChanged">
                                        <option value="" disabled selected>Seleccionar...</option>
                                        @foreach (var state in _mexicanStates)
                                        {
                                            <option value="@state">@state</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        @* ── Shipping type selector ── *@
                        <h3 class="text-lg font-semibold text-primary mt-8 mb-4">Método de envío</h3>

                        <div class="grid sm:grid-cols-2 gap-4">
                            @* Local *@
                            <button type="button"
                                    class="text-left rounded-2xl border-2 p-5 transition-all duration-200 cursor-pointer
                                        @(_model.ShippingType == "local"
                                            ? "border-accent bg-accent/10 shadow-soft"
                                            : "border-base-300 bg-base-100 hover:border-neutral/40")"
                                    @onclick='() => _model.ShippingType = "local"'>
                                <div class="flex items-center gap-3 mb-2">
                                    <div class="w-5 h-5 rounded-full border-2 flex items-center justify-center
                                        @(_model.ShippingType == "local" ? "border-primary" : "border-base-300")">
                                        @if (_model.ShippingType == "local")
                                        {
                                            <div class="w-2.5 h-2.5 rounded-full bg-primary"></div>
                                        }
                                    </div>
                                    <span class="font-semibold text-primary">Entrega local Reynosa</span>
                                    <span class="ml-auto badge badge-sm bg-success text-success-content border-0 font-bold">GRATIS</span>
                                </div>
                                <p class="text-sm text-base-content/60 ml-8">
                                    <i class="fa-solid fa-clock mr-1"></i>@Shipping.LocalDeliveryTime
                                </p>
                            </button>

                            @* Nacional *@
                            <button type="button"
                                    class="text-left rounded-2xl border-2 p-5 transition-all duration-200 cursor-pointer
                                        @(_model.ShippingType == "nacional"
                                            ? "border-accent bg-accent/10 shadow-soft"
                                            : "border-base-300 bg-base-100 hover:border-neutral/40")"
                                    @onclick='() => _model.ShippingType = "nacional"'>
                                <div class="flex items-center gap-3 mb-2">
                                    <div class="w-5 h-5 rounded-full border-2 flex items-center justify-center
                                        @(_model.ShippingType == "nacional" ? "border-primary" : "border-base-300")">
                                        @if (_model.ShippingType == "nacional")
                                        {
                                            <div class="w-2.5 h-2.5 rounded-full bg-primary"></div>
                                        }
                                    </div>
                                    <span class="font-semibold text-primary">Envío nacional por @Shipping.NationalCarrier</span>
                                    <span class="ml-auto font-bold text-primary">@FormatPrice(Shipping.NationalShippingCost.Amount)</span>
                                </div>
                                <p class="text-sm text-base-content/60 ml-8">
                                    <i class="fa-solid fa-clock mr-1"></i>@Shipping.NationalDeliveryTime
                                </p>
                            </button>
                        </div>

                        @if (_showValidation && _validationErrors.Any())
                        {
                            <div class="alert bg-error/10 text-error border border-error/20 mt-6 rounded-xl">
                                <i class="fa-solid fa-circle-exclamation"></i>
                                <span>Por favor completa todos los campos requeridos.</span>
                            </div>
                        }

                        <div class="flex justify-end mt-8">
                            <button class="btn bg-primary text-primary-content border-0 rounded-full px-8"
                                    @onclick="GoToStep2">
                                Continuar al pago
                                <i class="fa-solid fa-arrow-right ml-2"></i>
                            </button>
                        </div>
                    </div>
                }

                @* ═══════════════ STEP 2: PAYMENT ═══════════════ *@
                @if (_currentStep == 2)
                {
                    <div class="page-enter">
                        <h2 class="text-xl font-semibold text-primary mb-6">
                            <i class="fa-solid fa-credit-card mr-2"></i>Método de pago
                        </h2>

                        <div class="space-y-4">
                            @* Card *@
                            <div class="rounded-2xl border-2 transition-all duration-200
                                @(_model.PaymentMethod == "card"
                                    ? "border-accent bg-accent/10 shadow-soft"
                                    : "border-base-300 bg-base-100 hover:border-neutral/40")">
                                <button type="button" class="w-full text-left p-5 cursor-pointer"
                                        @onclick='() => _model.PaymentMethod = "card"'>
                                    <div class="flex items-center gap-3">
                                        <div class="w-5 h-5 rounded-full border-2 flex items-center justify-center
                                            @(_model.PaymentMethod == "card" ? "border-primary" : "border-base-300")">
                                            @if (_model.PaymentMethod == "card")
                                            {
                                                <div class="w-2.5 h-2.5 rounded-full bg-primary"></div>
                                            }
                                        </div>
                                        <i class="fa-solid fa-credit-card text-primary text-lg"></i>
                                        <span class="font-semibold text-primary">Tarjeta de crédito/débito</span>
                                    </div>
                                </button>

                                @if (_model.PaymentMethod == "card")
                                {
                                    <div class="px-5 pb-5 space-y-4 animate-fade-in-up">
                                        @* Card preview *@
                                        <div class="relative w-full max-w-sm mx-auto aspect-[1.586/1] rounded-2xl bg-gradient-to-br from-primary to-neutral p-6 text-primary-content overflow-hidden shadow-soft-lg">
                                            <div class="absolute top-0 right-0 w-32 h-32 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
                                            <div class="absolute bottom-0 left-0 w-24 h-24 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2"></div>
                                            <div class="flex flex-col justify-between h-full relative z-10">
                                                <div class="flex items-center justify-between">
                                                    <i class="fa-solid fa-microchip text-2xl text-primary-content/60"></i>
                                                    <i class="fa-solid fa-wifi text-lg text-primary-content/40 rotate-90"></i>
                                                </div>
                                                <div class="font-mono text-lg tracking-[0.2em]">
                                                    @(string.IsNullOrWhiteSpace(_model.CardNumber)
                                                        ? "•••• •••• •••• ••••"
                                                        : FormatCardDisplay(_model.CardNumber))
                                                </div>
                                                <div class="flex items-end justify-between">
                                                    <div>
                                                        <p class="text-[10px] uppercase text-primary-content/50 tracking-wider">Titular</p>
                                                        <p class="text-sm font-medium tracking-wide">
                                                            @(string.IsNullOrWhiteSpace(_model.CardName) ? "NOMBRE COMPLETO" : _model.CardName.ToUpperInvariant())
                                                        </p>
                                                    </div>
                                                    <div class="text-right">
                                                        <p class="text-[10px] uppercase text-primary-content/50 tracking-wider">Expira</p>
                                                        <p class="text-sm font-medium">
                                                            @(string.IsNullOrWhiteSpace(_model.CardExpiry) ? "MM/YY" : _model.CardExpiry)
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        @* Card inputs *@
                                        <div>
                                            <label class="label"><span class="label-text font-medium">Número de tarjeta</span></label>
                                            <input type="text" placeholder="1234 5678 9012 3456" maxlength="19"
                                                   class="input input-bordered w-full rounded-xl font-mono @(ShowError("CardNumber"))"
                                                   value="@FormatCardInput(_model.CardNumber)"
                                                   @oninput="OnCardNumberInput" />
                                        </div>

                                        <div class="grid grid-cols-3 gap-4">
                                            <div>
                                                <label class="label"><span class="label-text font-medium">Expiración</span></label>
                                                <input type="text" placeholder="MM/YY" maxlength="5"
                                                       class="input input-bordered w-full rounded-xl @(ShowError("CardExpiry"))"
                                                       value="@_model.CardExpiry"
                                                       @oninput="OnCardExpiryInput" />
                                            </div>
                                            <div>
                                                <label class="label"><span class="label-text font-medium">CVV</span></label>
                                                <input type="password" placeholder="•••" maxlength="3"
                                                       class="input input-bordered w-full rounded-xl @(ShowError("CardCvv"))"
                                                       @bind="_model.CardCvv" @bind:event="oninput" />
                                            </div>
                                            <div>
                                                <label class="label"><span class="label-text font-medium">Titular</span></label>
                                                <input type="text" placeholder="Nombre"
                                                       class="input input-bordered w-full rounded-xl @(ShowError("CardName"))"
                                                       @bind="_model.CardName" @bind:event="oninput" />
                                            </div>
                                        </div>

                                        <p class="text-xs text-base-content/50 flex items-center gap-1">
                                            <i class="fa-solid fa-lock"></i>
                                            No se guardan datos de tarjeta
                                        </p>
                                    </div>
                                }
                            </div>

                            @* Mercado Pago *@
                            <button type="button"
                                    class="w-full text-left rounded-2xl border-2 p-5 transition-all duration-200 cursor-pointer
                                        @(_model.PaymentMethod == "mercadopago"
                                            ? "border-accent bg-accent/10 shadow-soft"
                                            : "border-base-300 bg-base-100 hover:border-neutral/40")"
                                    @onclick='() => _model.PaymentMethod = "mercadopago"'>
                                <div class="flex items-center gap-3">
                                    <div class="w-5 h-5 rounded-full border-2 flex items-center justify-center
                                        @(_model.PaymentMethod == "mercadopago" ? "border-primary" : "border-base-300")">
                                        @if (_model.PaymentMethod == "mercadopago")
                                        {
                                            <div class="w-2.5 h-2.5 rounded-full bg-primary"></div>
                                        }
                                    </div>
                                    <i class="fa-solid fa-handshake text-primary text-lg"></i>
                                    <span class="font-semibold text-primary">Mercado Pago</span>
                                    <span class="text-xs text-base-content/50 ml-auto">Redirigir al pagar</span>
                                </div>
                            </button>

                            @* Efectivo *@
                            <button type="button"
                                    class="w-full text-left rounded-2xl border-2 p-5 transition-all duration-200 cursor-pointer
                                        @(_model.PaymentMethod == "cash"
                                            ? "border-accent bg-accent/10 shadow-soft"
                                            : "border-base-300 bg-base-100 hover:border-neutral/40")"
                                    @onclick='() => _model.PaymentMethod = "cash"'>
                                <div class="flex items-center gap-3">
                                    <div class="w-5 h-5 rounded-full border-2 flex items-center justify-center
                                        @(_model.PaymentMethod == "cash" ? "border-primary" : "border-base-300")">
                                        @if (_model.PaymentMethod == "cash")
                                        {
                                            <div class="w-2.5 h-2.5 rounded-full bg-primary"></div>
                                        }
                                    </div>
                                    <i class="fa-solid fa-store text-primary text-lg"></i>
                                    <span class="font-semibold text-primary">Efectivo en tiendas de conveniencia</span>
                                    <span class="text-xs text-base-content/50 ml-auto">OXXO, 7-Eleven, etc.</span>
                                </div>
                            </button>
                        </div>

                        @if (_showValidation && _validationErrors.Any())
                        {
                            <div class="alert bg-error/10 text-error border border-error/20 mt-6 rounded-xl">
                                <i class="fa-solid fa-circle-exclamation"></i>
                                <span>@_validationErrors.First()</span>
                            </div>
                        }

                        <div class="flex justify-between mt-8">
                            <button class="btn btn-ghost text-primary rounded-full px-6"
                                    @onclick="GoBack">
                                <i class="fa-solid fa-arrow-left mr-2"></i>
                                Regresar
                            </button>
                            <button class="btn bg-primary text-primary-content border-0 rounded-full px-8"
                                    @onclick="GoToStep3">
                                Confirmar pedido
                                <i class="fa-solid fa-check ml-2"></i>
                            </button>
                        </div>
                    </div>
                }

                @* ═══════════════ STEP 3: CONFIRMATION ═══════════════ *@
                @if (_currentStep == 3)
                {
                    <div class="page-enter">
                        @if (_processing)
                        {
                            @* Processing animation *@
                            <div class="flex flex-col items-center justify-center py-20">
                                <div class="coin">
                                    <div class="coin-face coin-front">
                                        <i class="fa-solid fa-paw"></i>
                                    </div>
                                    <div class="coin-face coin-back">
                                        <span class="coin-text">LP</span>
                                    </div>
                                </div>
                                <p class="loading-text mt-6 text-primary font-medium animate-pulse">
                                    Procesando pago...
                                </p>
                            </div>
                        }
                        else
                        {
                            @* Success screen *@
                            <div class="flex justify-center">
                            <div class="text-center py-8 relative overflow-hidden w-full max-w-2xl mx-auto">
                                @* Patitas confetti (CSS only) *@
                                <div class="checkout-confetti" aria-hidden="true">
                                    @for (int p = 0; p < 12; p++)
                                    {
                                        <span class="confetti-paw" style="--i:@p"></span>
                                    }
                                </div>

                                @* Animated check *@
                                <div class="mx-auto w-24 h-24 rounded-full bg-success/20 flex items-center justify-center mb-6 checkout-check-pop">
                                    <div class="w-16 h-16 rounded-full bg-success flex items-center justify-center">
                                        <i class="fa-solid fa-check text-success-content text-3xl"></i>
                                    </div>
                                </div>

                                <h2 class="text-2xl sm:text-3xl font-bold text-primary mb-2">
                                    ¡Pedido confirmado!
                                </h2>
                                <p class="text-base-content/60 mb-6">Tu pedido ha sido procesado exitosamente</p>

                                <div class="inline-block bg-base-200 rounded-full px-6 py-2 mb-8">
                                    <span class="text-sm text-base-content/60">Número de pedido:</span>
                                    <span class="font-bold text-primary ml-1">@_orderNumber</span>
                                </div>

                                @* Order details card *@
                                <div class="bg-base-100 rounded-2xl shadow-soft p-6 max-w-lg mx-auto text-left space-y-5">
                                    @* Items *@
                                    <div>
                                        <h4 class="font-semibold text-primary text-sm mb-3">Artículos</h4>
                                        @foreach (var item in _items)
                                        {
                                            <div class="flex items-center gap-3 mb-2">
                                                <img src="@item.Image" alt="@item.ProductName"
                                                     class="w-10 h-10 rounded-lg bg-secondary/40 object-contain p-1" />
                                                <div class="flex-1 min-w-0">
                                                    <p class="text-sm text-base-content truncate">@item.ProductName</p>
                                                    <p class="text-xs text-base-content/50">x@item.Quantity · @item.ColorName</p>
                                                </div>
                                                <span class="text-sm font-medium">@FormatPrice(item.LineTotal)</span>
                                            </div>
                                        }
                                    </div>

                                    <div class="divider my-0"></div>

                                    @* Totals *@
                                    <div class="space-y-2 text-sm">
                                        <div class="flex justify-between">
                                            <span class="text-base-content/70">Subtotal</span>
                                            <span>@FormatPrice(_subtotal)</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-base-content/70">
                                                Envío (@(_model.ShippingType == "local" ? "Local Reynosa" : Shipping.NationalCarrier))
                                            </span>
                                            <span class="@(_shippingCost == 0 ? "text-success font-semibold" : "")">
                                                @(_shippingCost == 0 ? "Gratis" : FormatPrice(_shippingCost))
                                            </span>
                                        </div>
                                    </div>

                                    <div class="divider my-0"></div>

                                    <div class="flex justify-between text-lg font-bold text-primary">
                                        <span>Total</span>
                                        <span>@FormatPrice(_total)</span>
                                    </div>

                                    @* Shipping info *@
                                    <div class="bg-base-200 rounded-xl p-4 text-sm space-y-1">
                                        <div class="flex items-center gap-2 text-primary font-medium">
                                            <i class="fa-solid fa-truck"></i>
                                            <span>@(_model.ShippingType == "local" ? "Entrega local Reynosa" : $"Envío nacional por {Shipping.NationalCarrier}")</span>
                                        </div>
                                        <p class="text-base-content/60">
                                            Tiempo estimado: @(_model.ShippingType == "local" ? Shipping.LocalDeliveryTime : Shipping.NationalDeliveryTime)
                                        </p>
                                        <p class="text-base-content/60">
                                            Fecha estimada de entrega: @GetEstimatedDelivery()
                                        </p>
                                    </div>
                                </div>

                                @* Account suggestion *@
                                @if (_loggedInUser is not null)
                                {
                                    <div class="bg-secondary/30 rounded-2xl p-5 mt-6 max-w-lg mx-auto">
                                        <p class="text-sm text-primary font-medium mb-2">
                                            <i class="fa-solid fa-truck-fast mr-1"></i>
                                            Rastrea tu pedido
                                        </p>
                                        <p class="text-xs text-base-content/60 mb-3">
                                            Consulta el estado de tu envío y fecha estimada de entrega.
                                        </p>
                                        <a href="cuenta?tab=rastreo&pedido=@_orderNumber" class="btn btn-sm bg-primary text-primary-content border-0 rounded-full">
                                            <i class="fa-solid fa-map-location-dot mr-1"></i> Ver rastreo
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <div class="bg-secondary/30 rounded-2xl p-5 mt-6 max-w-lg mx-auto">
                                        <p class="text-sm text-primary font-medium mb-2">
                                            <i class="fa-solid fa-user-plus mr-1"></i>
                                            ¿Quieres rastrear tus pedidos?
                                        </p>
                                        <p class="text-xs text-base-content/60 mb-3">
                                            Crea una cuenta para guardar tu información y ver el historial de compras.
                                        </p>
                                        <a href="cuenta" class="btn btn-sm bg-primary text-primary-content border-0 rounded-full">
                                            Crear cuenta
                                        </a>
                                    </div>
                                }

                                @* CTA *@
                                <button class="btn bg-primary text-primary-content border-0 rounded-full px-10 mt-8"
                                        @onclick="FinishAndGoHome">
                                    <i class="fa-solid fa-paw mr-2"></i>
                                    Seguir comprando
                                </button>
                            </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @* ═══════════════ ORDER SUMMARY SIDEBAR ═══════════════ *@
            @if (_currentStep < 3 || _processing)
            {
                <div class="lg:col-span-1">
                    <div class="bg-base-100 rounded-2xl shadow-soft p-6 space-y-4 sticky top-24">
                        <h3 class="font-semibold text-lg text-primary">Resumen del pedido</h3>

                        @* Items *@
                        <div class="space-y-3 max-h-64 overflow-y-auto pr-1">
                            @foreach (var item in _items)
                            {
                                <div class="flex items-center gap-3">
                                    <div class="relative shrink-0">
                                        <img src="@item.Image" alt="@item.ProductName"
                                             class="w-12 h-12 rounded-lg bg-secondary/40 object-contain p-1" />
                                        <span class="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-primary text-primary-content text-[10px] font-bold flex items-center justify-center">
                                            @item.Quantity
                                        </span>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-xs font-medium text-base-content truncate">@item.ProductName</p>
                                        <p class="text-[10px] text-base-content/50">@item.ColorName</p>
                                    </div>
                                    <span class="text-xs font-semibold text-primary shrink-0">@FormatPrice(item.LineTotal)</span>
                                </div>
                            }
                        </div>

                        <div class="divider my-0"></div>

                        @* Totals *@
                        <div class="space-y-2 text-sm">
                            <div class="flex justify-between">
                                <span class="text-base-content/70">Subtotal</span>
                                <span class="font-medium">@FormatPrice(_subtotal)</span>
                            </div>

                            <div class="flex justify-between">
                                <span class="text-base-content/70">Envío</span>
                                <span class="@(_model.ShippingType == "local" ? "text-success font-semibold" : _model.ShippingType == "" ? "text-base-content/40 italic" : "font-medium")">
                                    @if (string.IsNullOrEmpty(_model.ShippingType))
                                    {
                                        <text>Selecciona un método</text>
                                    }
                                    else if (_shippingCost == 0)
                                    {
                                        <text>Gratis</text>
                                    }
                                    else
                                    {
                                        <text>@FormatPrice(_shippingCost) (@Shipping.NationalCarrier)</text>
                                    }
                                </span>
                            </div>
                        </div>

                        <div class="divider my-0"></div>

                        <div class="flex justify-between text-lg font-bold text-primary">
                            <span>Total</span>
                            <span>@FormatPrice(_total)</span>
                        </div>

                        <p class="text-[10px] text-base-content/40 text-center">Precios en MXN, IVA incluido</p>
                    </div>
                </div>
            }
        </div>
    }
</section>

@* ── Checkout-specific styles (CSS only confetti + animations) ── *@
<style>
    .checkout-confetti {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
    }

    .confetti-paw {
        position: absolute;
        font-size: 1.2rem;
        opacity: 0;
        animation: confetti-fall 3s ease-in-out forwards;
        animation-delay: calc(var(--i) * 0.15s);
    }

    .confetti-paw::before {
        content: '\1F43E'; /* paw prints emoji as fallback */
        display: block;
    }

    /* Distribute paws across the width */
    .confetti-paw:nth-child(1)  { left: 5%;  }
    .confetti-paw:nth-child(2)  { left: 15%; }
    .confetti-paw:nth-child(3)  { left: 25%; }
    .confetti-paw:nth-child(4)  { left: 35%; }
    .confetti-paw:nth-child(5)  { left: 45%; }
    .confetti-paw:nth-child(6)  { left: 55%; }
    .confetti-paw:nth-child(7)  { left: 65%; }
    .confetti-paw:nth-child(8)  { left: 75%; }
    .confetti-paw:nth-child(9)  { left: 85%; }
    .confetti-paw:nth-child(10) { left: 92%; }
    .confetti-paw:nth-child(11) { left: 10%; }
    .confetti-paw:nth-child(12) { left: 50%; }

    @@keyframes confetti-fall {
        0%   { transform: translateY(-40px) rotate(0deg) scale(0);   opacity: 0; }
        20%  { opacity: 1; transform: translateY(20px) rotate(45deg) scale(1); }
        80%  { opacity: 0.7; }
        100% { transform: translateY(300px) rotate(360deg) scale(0.6); opacity: 0; }
    }

    .checkout-check-pop {
        animation: check-pop 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    @@keyframes check-pop {
        0%   { transform: scale(0); opacity: 0; }
        60%  { transform: scale(1.15); }
        100% { transform: scale(1); opacity: 1; }
    }
</style>

@code {
    private List<LokyPet.Application.DTOs.CartItemDto> _items = new();
    private bool _loading = true;
    private int _currentStep = 1;
    private bool _processing;
    private string _orderNumber = "";
    private LokyPet.Domain.Entities.UserProfile? _loggedInUser;

    private decimal _subtotal;
    private decimal _shippingCost;
    private decimal _total;

    private CheckoutModel _model = new();
    private bool _showValidation;
    private List<string> _validationErrors = new();

    private static readonly System.Globalization.CultureInfo Mx = LokyPet.Domain.ValueObjects.Money.MxDot;
    private static string FormatPrice(decimal v) => v.ToString("C2", Mx);

    // ── Mexican states ──
    private static readonly string[] _mexicanStates =
    {
        "Aguascalientes", "Baja California", "Baja California Sur", "Campeche",
        "Chiapas", "Chihuahua", "Ciudad de México", "Coahuila", "Colima",
        "Durango", "Estado de México", "Guanajuato", "Guerrero", "Hidalgo",
        "Jalisco", "Michoacán", "Morelos", "Nayarit", "Nuevo León", "Oaxaca",
        "Puebla", "Querétaro", "Quintana Roo", "San Luis Potosí", "Sinaloa",
        "Sonora", "Tabasco", "Tamaulipas", "Tlaxcala", "Veracruz",
        "Yucatán", "Zacatecas"
    };

    protected override async Task OnInitializedAsync()
    {
        Cart.OnChange += OnCartChanged;
        _items = await Cart.GetItemsAsync();

        if (!_items.Any())
        {
            Nav.NavigateTo("carrito");
            return;
        }

        RecalcTotals();

        // Pre-fill form with user profile data if logged in
        var user = await Auth.GetCurrentUserAsync();
        if (user is not null)
        {
            _loggedInUser = user;
            _model.Name = user.FullName;
            _model.Phone = user.Phone ?? "";
            _model.Email = user.Email ?? "";
            if (!string.IsNullOrEmpty(user.DefaultAddress))
                _model.Address = user.DefaultAddress;
        }

        _loading = false;
    }

    private async void OnCartChanged()
    {
        await InvokeAsync(async () =>
        {
            _items = await Cart.GetItemsAsync();
            RecalcTotals();
            StateHasChanged();
        });
    }

    private void RecalcTotals()
    {
        _subtotal = _items.Sum(i => i.LineTotal);

        if (_model.ShippingType == "local")
            _shippingCost = 0m;
        else if (_model.ShippingType == "nacional")
            _shippingCost = Shipping.NationalShippingCost.Amount;
        else
            _shippingCost = 0m; // No type selected yet

        _total = _subtotal + _shippingCost;
    }

    private void OnAddressChanged()
    {
        // Auto-select shipping type based on city/state
        var resolved = Shipping.Resolve(_model.City, _model.State);
        _model.ShippingType = resolved == LokyPet.Domain.Enums.ShippingType.Local ? "local" : "nacional";
        RecalcTotals();
    }

    // ── Validation ──

    private string ShowError(string field)
    {
        return _showValidation && _validationErrors.Contains(field)
            ? "input-error border-error"
            : "";
    }

    private List<string> ValidateStep1()
    {
        var errors = new List<string>();
        if (string.IsNullOrWhiteSpace(_model.Name)) errors.Add(nameof(_model.Name));
        if (string.IsNullOrWhiteSpace(_model.Phone)) errors.Add(nameof(_model.Phone));
        if (string.IsNullOrWhiteSpace(_model.Email)) errors.Add(nameof(_model.Email));
        if (string.IsNullOrWhiteSpace(_model.Address)) errors.Add(nameof(_model.Address));
        if (string.IsNullOrWhiteSpace(_model.ZipCode)) errors.Add(nameof(_model.ZipCode));
        if (string.IsNullOrWhiteSpace(_model.City)) errors.Add(nameof(_model.City));
        if (string.IsNullOrWhiteSpace(_model.State)) errors.Add(nameof(_model.State));
        if (string.IsNullOrWhiteSpace(_model.ShippingType)) errors.Add("ShippingType");
        return errors;
    }

    private List<string> ValidateStep2()
    {
        var errors = new List<string>();
        if (_model.PaymentMethod == "card")
        {
            var digitsOnly = new string(_model.CardNumber.Where(char.IsDigit).ToArray());
            if (string.IsNullOrWhiteSpace(digitsOnly) || digitsOnly.Length < 13)
                errors.Add("CardNumber");

            if (string.IsNullOrWhiteSpace(_model.CardExpiry) || _model.CardExpiry.Length < 5)
                errors.Add("CardExpiry");
            if (string.IsNullOrWhiteSpace(_model.CardCvv) || _model.CardCvv.Length < 3)
                errors.Add("CardCvv");
            if (string.IsNullOrWhiteSpace(_model.CardName))
                errors.Add("CardName");
        }
        return errors;
    }

    // ── Step navigation ──

    private void GoToStep2()
    {
        _validationErrors = ValidateStep1();
        _showValidation = true;
        if (_validationErrors.Any()) return;

        _showValidation = false;
        RecalcTotals();
        _currentStep = 2;
    }

    private async Task GoToStep3()
    {
        _validationErrors = ValidateStep2();
        _showValidation = true;
        if (_validationErrors.Any()) return;

        _showValidation = false;
        _currentStep = 3;
        _processing = true;
        StateHasChanged();

        // Simulate processing delay
        await Task.Delay(2500);

        _processing = false;
        _orderNumber = $"LKP-2026-{Random.Shared.Next(100000, 999999)}";

        // Save order to database
        try
        {
            var order = new LokyPet.Domain.Entities.Order
            {
                OrderNumber = _orderNumber,
                UserId = _loggedInUser?.Id,
                CustomerName = _model.Name,
                CustomerEmail = _model.Email,
                CustomerPhone = _model.Phone,
                ShippingAddress = _model.Address,
                ShippingCity = _model.City,
                ShippingState = _model.State,
                ShippingZipCode = _model.ZipCode,
                ShippingType = _model.ShippingType == "local" 
                    ? LokyPet.Domain.Enums.ShippingType.Local 
                    : LokyPet.Domain.Enums.ShippingType.Nacional,
                ShippingCarrier = _model.ShippingType == "nacional" ? Shipping.NationalCarrier : null,
                Subtotal = _subtotal,
                DiscountTotal = 0m,
                ShippingCost = _shippingCost,
                Total = _total,
                Items = _items.Select(i => new LokyPet.Domain.Entities.OrderItem
                {
                    VariantId = i.VariantId,
                    Sku = i.Sku,
                    Name = i.ProductName,
                    Color = i.ColorName,
                    UnitPrice = i.UnitPrice,
                    CompareAtPrice = i.CompareAtPrice,
                    Quantity = i.Quantity,
                    LineTotal = i.LineTotal
                }).ToList()
            };
            await Orders.CreateOrderAsync(order);
        }
        catch { /* Order saved is best-effort in demo mode */ }

        // Clear the cart after successful order
        await Cart.ClearAsync();

        StateHasChanged();
    }

    private void GoBack()
    {
        _showValidation = false;
        _validationErrors.Clear();
        _currentStep--;
    }

    private async Task FinishAndGoHome()
    {
        await Cart.ClearAsync();
        Nav.NavigateTo("");
    }

    // ── Card formatting helpers ──

    private void OnCardNumberInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        _model.CardNumber = new string(raw.Where(char.IsDigit).ToArray());
        if (_model.CardNumber.Length > 16)
            _model.CardNumber = _model.CardNumber[..16];
    }

    private void OnCardExpiryInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        var digits = new string(raw.Where(char.IsDigit).ToArray());
        if (digits.Length > 4) digits = digits[..4];

        _model.CardExpiry = digits.Length >= 3
            ? $"{digits[..2]}/{digits[2..]}"
            : digits;
    }

    private static string FormatCardInput(string digits)
    {
        if (string.IsNullOrEmpty(digits)) return "";
        var groups = new List<string>();
        for (int i = 0; i < digits.Length; i += 4)
            groups.Add(digits.Substring(i, Math.Min(4, digits.Length - i)));
        return string.Join(" ", groups);
    }

    private static string FormatCardDisplay(string digits)
    {
        var padded = digits.PadRight(16, '•');
        return $"{padded[..4]} {padded[4..8]} {padded[8..12]} {padded[12..16]}";
    }

    private static bool PassesLuhn(string number)
    {
        var digits = number.Where(char.IsDigit).Select(c => c - '0').ToArray();
        if (digits.Length < 13) return false;

        int sum = 0;
        bool alt = false;
        for (int i = digits.Length - 1; i >= 0; i--)
        {
            int n = digits[i];
            if (alt)
            {
                n *= 2;
                if (n > 9) n -= 9;
            }
            sum += n;
            alt = !alt;
        }
        return sum % 10 == 0;
    }

    // ── Estimated delivery ──

    private string GetEstimatedDelivery()
    {
        // 1 day processing + delivery window in business days
        var today = DateTime.Now;
        int processingDays = 1;
        int deliveryDaysMin = _model.ShippingType == "local" ? 1 : 3;
        int deliveryDaysMax = _model.ShippingType == "local" ? 2 : 5;

        var minDate = AddBusinessDays(today, processingDays + deliveryDaysMin);
        var maxDate = AddBusinessDays(today, processingDays + deliveryDaysMax);

        var culture = new System.Globalization.CultureInfo("es-MX");
        return $"{minDate.ToString("d 'de' MMMM", culture)} — {maxDate.ToString("d 'de' MMMM", culture)}";
    }

    private static DateTime AddBusinessDays(DateTime start, int days)
    {
        var current = start;
        int added = 0;
        while (added < days)
        {
            current = current.AddDays(1);
            if (current.DayOfWeek != DayOfWeek.Saturday && current.DayOfWeek != DayOfWeek.Sunday)
                added++;
        }
        return current;
    }

    public void Dispose()
    {
        Cart.OnChange -= OnCartChanged;
    }

    // ── Checkout model ──

    private sealed class CheckoutModel
    {
        public string Name { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Email { get; set; } = "";
        public string Address { get; set; } = "";
        public string ZipCode { get; set; } = "";
        public string City { get; set; } = "";
        public string State { get; set; } = "";
        public string ShippingType { get; set; } = "";
        public string PaymentMethod { get; set; } = "card";
        public string CardNumber { get; set; } = "";
        public string CardExpiry { get; set; } = "";
        public string CardCvv { get; set; } = "";
        public string CardName { get; set; } = "";
    }
}
