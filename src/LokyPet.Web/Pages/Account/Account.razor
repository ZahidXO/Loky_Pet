@code {
    // ===== State =====
    private LokyPet.Domain.Entities.UserProfile? _user;
    private bool _loading = true;
    private bool _submitting;
    private string? _errorMsg;
    private string? _successMsg;

    // Auth views
    private AuthView _authView = AuthView.Login;
    private LoginModel _loginModel = new();
    private RegisterModel _registerModel = new();
    private string _resetEmail = "";
    private bool _resetSent;

    // Profile tab
    private ProfileTab _profileTab = ProfileTab.Profile;
    private string _editName = "";
    private string? _editPhone;
    private string? _editAddress;
    private string? _profileMsg;
    private bool _profileSuccess;

    // Orders
    private List<LokyPet.Domain.Entities.Order> _orders = new();
    private bool _ordersLoading;

    // Tracking
    private string? _expandedTrackingOrderNumber;
    private int _truckX = 380;
    private int _truckY = 100;
    private string _truckStateName = "Nuevo León";

    // Truck position presets (state name → SVG coords on the simplified map)
    private static readonly (string Name, int X, int Y)[] _truckPositions =
    {
        ("Tamaulipas", 450, 75),
        ("Nuevo León", 380, 100),
        ("Chihuahua", 300, 80),
        ("Sonora", 260, 100),
        ("Jalisco", 340, 200),
        ("Ciudad de México", 370, 250),
        ("Oaxaca", 420, 280),
        ("Veracruz", 470, 260),
        ("Durango", 320, 140),
        ("Baja California", 200, 60),
        ("Yucatán", 500, 300),
    };

    // Formatting
    private static readonly System.Globalization.CultureInfo Mx = LokyPet.Domain.ValueObjects.Money.MxDot;
    private static string FormatPrice(decimal v) => v.ToString("C2", Mx);

    // ===== Lifecycle =====
    protected override async Task OnInitializedAsync()
    {
        Auth.OnAuthStateChanged += OnAuthChanged;
        await LoadUser();

        var uri = Nav.Uri;
        var queryIdx = uri.IndexOf('?');
        if (queryIdx >= 0)
        {
            var queryStr = uri[(queryIdx + 1)..];
            var pairs = queryStr.Split('&');
            var tabVal = pairs.FirstOrDefault(p => p.StartsWith("tab="))?.Split('=').ElementAtOrDefault(1);
            var pedidoVal = pairs.FirstOrDefault(p => p.StartsWith("pedido="))?.Split('=').ElementAtOrDefault(1);
            if (tabVal == "rastreo")
            {
                _profileTab = ProfileTab.Orders;
                _expandedTrackingOrderNumber = Uri.UnescapeDataString(pedidoVal ?? "");
                // Randomize truck position
                var pos = _truckPositions[Random.Shared.Next(_truckPositions.Length)];
                _truckX = pos.X;
                _truckY = pos.Y;
                _truckStateName = pos.Name;
            }
        }
    }

    private async Task LoadUser()
    {
        _loading = true;
        StateHasChanged();

        _user = await Auth.GetCurrentUserAsync();
        if (_user is not null)
        {
            _editName = _user.FullName;
            _editPhone = _user.Phone;
            _editAddress = _user.DefaultAddress;
        }

        _loading = false;
        StateHasChanged();
    }

    private async void OnAuthChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadUser();
            StateHasChanged();
        });
    }

    // ===== Auth handlers =====
    private async Task HandleLogin()
    {
        _errorMsg = null;
        _submitting = true;
        StateHasChanged();

        var success = await Auth.SignInAsync(_loginModel.Email, _loginModel.Password);
        _submitting = false;

        if (!success)
        {
            var detail = (Auth as LokyPet.Client.Services.AuthService)?.LastError ?? "";
            string msg;
            if (detail.Contains("rate_limit", StringComparison.OrdinalIgnoreCase)
                || detail.Contains("request this after", StringComparison.OrdinalIgnoreCase)
                || detail.Contains("429", StringComparison.OrdinalIgnoreCase))
                msg = "Demasiados intentos. Espera 1 minuto antes de intentar de nuevo.";
            else if (detail.Contains("invalid", StringComparison.OrdinalIgnoreCase) || detail.Contains("credentials", StringComparison.OrdinalIgnoreCase))
                msg = "Correo o contrase\u00f1a incorrectos. Intenta de nuevo.";
            else
                msg = $"Error al iniciar sesi\u00f3n.\n(Detalle: {detail})";
            await ShowError(msg);
        }
    }

    private async Task HandleRegister()
    {
        _errorMsg = null;
        _successMsg = null;

        if (!_registerModel.PrivacyAccepted)
        {
            await ShowError("Debes aceptar el Aviso de Privacidad.");
            return;
        }

        _submitting = true;
        StateHasChanged();

        var success = await Auth.SignUpAsync(_registerModel.Email, _registerModel.Password, _registerModel.FullName);
        _submitting = false;

        if (success)
        {
            // Check if user was auto-logged in (email confirmation disabled)
            var user = await Auth.GetCurrentUserAsync();
            if (user is null)
            {
                // Email confirmation is enabled — user must verify their email first
                _successMsg = "Cuenta creada. Revisa tu correo para confirmar tu cuenta e inicia sesión.";
                _authView = AuthView.Login;
                _registerModel = new();
                StateHasChanged();
                await Task.Delay(3000);
                if (_successMsg is not null) { _successMsg = null; StateHasChanged(); }
            }
            // else: OnAuthStateChanged already refreshed the UI
        }
        else
        {
            var detail = (Auth as LokyPet.Client.Services.AuthService)?.LastError ?? "";
            string msg;
            if (detail.Contains("already_registered", StringComparison.OrdinalIgnoreCase) || detail.Contains("already", StringComparison.OrdinalIgnoreCase))
                msg = "Este correo ya tiene una cuenta. Intenta iniciar sesión.";
            else if (detail.Contains("rate_limit", StringComparison.OrdinalIgnoreCase)
                     || detail.Contains("request this after", StringComparison.OrdinalIgnoreCase)
                     || detail.Contains("429", StringComparison.OrdinalIgnoreCase))
                msg = "Demasiados intentos. Espera 1 minuto antes de intentar de nuevo.";
            else if (detail.Contains("invalid", StringComparison.OrdinalIgnoreCase))
                msg = "El correo ingresado no es válido. Verifica que esté bien escrito.";
            else if (detail.Contains("disabled", StringComparison.OrdinalIgnoreCase))
                msg = "El registro por correo está deshabilitado en Supabase. Actívalo en Authentication → Providers → Email.";
            else
                msg = $"No se pudo crear la cuenta.\n(Detalle: {detail})";
            await ShowError(msg);
        }
    }

    /// <summary>Show error message that auto-dismisses after 3 seconds.</summary>
    private async Task ShowError(string msg)
    {
        _errorMsg = msg;
        StateHasChanged();
        await Task.Delay(3000);
        if (_errorMsg == msg) // Only clear if it's still the same message
        {
            _errorMsg = null;
            StateHasChanged();
        }
    }

    private async Task HandleResetPassword()
    {
        if (string.IsNullOrWhiteSpace(_resetEmail)) return;
        _submitting = true;
        StateHasChanged();

        await Auth.ResetPasswordAsync(_resetEmail);
        _submitting = false;
        _resetSent = true;
        StateHasChanged();
        await Task.Delay(3000);
        _resetSent = false;
        _authView = AuthView.Login;
        StateHasChanged();
    }

    private async Task HandleLogout()
    {
        await Auth.SignOutAsync();
        _user = null;
        _authView = AuthView.Login;
        _loginModel = new();
        _registerModel = new();
    }

    // ===== Profile handlers =====
    private async Task SaveProfile()
    {
        if (_user is null) return;
        _profileMsg = null;
        _submitting = true;
        StateHasChanged();

        _user.FullName = _editName?.Trim() ?? "";
        _user.Phone = _editPhone?.Trim();
        _user.DefaultAddress = _editAddress?.Trim();

        var result = await Auth.UpdateProfileAsync(_user);
        _submitting = false;

        if (result is not null)
        {
            _profileMsg = "\u00a1Perfil actualizado!";
            _profileSuccess = true;
        }
        else
        {
            var detail = (Auth as LokyPet.Client.Services.AuthService)?.LastError ?? "";
            _profileMsg = string.IsNullOrEmpty(detail)
                ? "Error al guardar los cambios."
                : $"Error al guardar los cambios.\n(Detalle: {detail})";
            _profileSuccess = false;
        }

        StateHasChanged();
        var msgSnapshot = _profileMsg;
        await Task.Delay(3000);
        if (_profileMsg == msgSnapshot)
        {
            _profileMsg = null;
            StateHasChanged();
        }
    }

    // ===== Orders loading (lazy on tab switch) =====
    private async Task LoadOrders()
    {
        if (_user is null || _orders.Count > 0) return;
        _ordersLoading = true;
        StateHasChanged();

        _orders = await Orders.GetOrdersByUserAsync(_user.Id);
        _ordersLoading = false;
    }

    // Override to trigger order loading when tab changes
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_profileTab == ProfileTab.Orders && _user is not null && _orders.Count == 0 && !_ordersLoading)
        {
            await LoadOrders();
            StateHasChanged();
        }
    }

    // ===== Tracking handlers =====
    private void ToggleTracking(string orderNumber)
    {
        if (_expandedTrackingOrderNumber == orderNumber)
        {
            _expandedTrackingOrderNumber = null;
        }
        else
        {
            _expandedTrackingOrderNumber = orderNumber;
            // Place truck at a random state position (simulated)
            var pos = _truckPositions[Random.Shared.Next(_truckPositions.Length)];
            _truckX = pos.X;
            _truckY = pos.Y;
            _truckStateName = pos.Name;
        }
    }

    private string GetTrackingDeliveryDateForOrder(LokyPet.Domain.Entities.Order order)
    {
        var created = order.CreatedAt;
        bool isLocal = order.ShippingType == LokyPet.Domain.Enums.ShippingType.Local;
        int minDays = isLocal ? 1 : 3;
        int maxDays = isLocal ? 2 : 5;
        var minDate = AddBusinessDays(created, 1 + minDays);
        var maxDate = AddBusinessDays(created, 1 + maxDays);
        var culture = new System.Globalization.CultureInfo("es-MX");
        return $"{minDate.ToString("d 'de' MMMM", culture)} — {maxDate.ToString("d 'de' MMMM", culture)}";
    }

    private static DateTime AddBusinessDays(DateTime start, int days)
    {
        var current = start;
        int added = 0;
        while (added < days)
        {
            current = current.AddDays(1);
            if (current.DayOfWeek != DayOfWeek.Saturday && current.DayOfWeek != DayOfWeek.Sunday)
                added++;
        }
        return current;
    }

